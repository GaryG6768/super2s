<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>SUPER 2s</title>
<link rel="manifest" href="./manifest-v2.webmanifest">
<meta name="theme-color" content="#111827">
<link rel="apple-touch-icon" href="./icon-192.png?v=2">
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
*{box-sizing:border-box}
body{margin:0;font-family:Arial,sans-serif;background:#f5f6f8;color:#111827;overflow-x:hidden}
.wrap{width:100%;max-width:620px;margin:auto;padding:12px}
.brand{text-align:center;margin:10px 0 16px}.brand h1{margin:0;font-size:40px;letter-spacing:1px}.brand p{margin:5px 0;color:#6b7280;font-size:18px}
.card{background:#fff;border-radius:18px;padding:18px;margin:12px 0;box-shadow:0 3px 14px #00000010}
h2{margin:0 0 12px;font-size:22px}.game{border:1px solid #e5e7eb;border-radius:14px;padding:14px;margin:10px 0}.game b{display:block;font-size:17px}.kick{color:#6b7280;font-size:14px;margin-top:5px}
label{font-size:14px;font-weight:700;display:block;margin:12px 0 5px}
input{width:100%;padding:13px;border:1px solid #d1d5db;border-radius:10px;font-size:17px}
.score{display:flex;gap:10px}.score input{text-align:center}
.btn{width:100%;border:0;border-radius:12px;padding:14px;font-size:17px;font-weight:800;margin-top:14px;background:#111827;color:#fff}
.btn:disabled{opacity:.5}.msg{padding:12px;border-radius:10px;background:#f3f4f6;margin-top:12px}.small{font-size:13px;color:#6b7280}
 .hidden{display:none}.listrow{padding:10px 0;border-bottom:1px solid #eee}.listrow:last-child{border-bottom:0}
.predTableWrap{width:100%;max-width:100%;overflow:hidden;margin-top:10px}.predTable{width:100%;max-width:100%;min-width:0;table-layout:fixed;border-collapse:separate;border-spacing:0 8px}.predTable th{background:#17334f;color:#fff;padding:11px 8px;text-align:center;font-size:14px}.predTable th:first-child{width:38%;border-radius:10px 0 0 10px;text-align:left}.predTable th:nth-child(2),.predTable th:nth-child(3){width:31%}.predTable th:last-child{border-radius:0 10px 10px 0}.predTable td{padding:12px 8px;text-align:center;font-weight:800;border-top:2px solid rgba(0,0,0,.08);border-bottom:2px solid rgba(0,0,0,.08)}.predTable td:first-child{text-align:left;font-size:16px;overflow-wrap:anywhere;border-left:2px solid rgba(0,0,0,.08);border-radius:12px 0 0 12px}.predTable td:last-child{border-right:2px solid rgba(0,0,0,.08);border-radius:0 12px 12px 0}.predScore{font-size:18px;font-weight:900;white-space:nowrap}.predTable .p0{background:#e0f2fe}.predTable .p1{background:#dcfce7}.predTable .p2{background:#fef3c7}.predTable .p3{background:#fce7f3}.predTable .p4{background:#ede9fe}.predTable .p5{background:#ffedd5}
.winner{display:none;text-align:center;background:#f7fbff;border:2px solid #1785ff;position:relative;overflow:hidden}
.trophy{font-size:92px;animation:bounce 1.2s infinite alternate}.gold{color:#0756c7}.pred{margin:8px 0;font-weight:700}
@keyframes bounce{to{transform:translateY(-8px) scale(1.04)}}
.confetti{position:absolute;inset:0;pointer-events:none}.confetti i{position:absolute;top:-20px;width:7px;height:14px;background:#1785ff;animation:fall 3s linear infinite}
.confetti i:nth-child(2n){background:#6fb5ff}@keyframes fall{to{transform:translateY(520px) rotate(540deg)}}
.wheelCard{background:radial-gradient(circle at 50% 20%,#16253d 0,#0a1220 48%,#02050b 100%);color:#fff;text-align:center;padding:18px;border-radius:24px;border:1px solid #183b67;box-shadow:0 12px 35px #0009}
.wheelTitle{font-size:28px;font-weight:900;letter-spacing:.5px;margin-bottom:5px}
.wheelSub{font-size:15px;color:#c7d3e2;margin-bottom:14px;line-height:1.35}
.wheelStage{position:relative;width:min(560px,94vw);height:min(560px,94vw);margin:0 auto 16px}
.wheel{width:100%;height:100%;border-radius:50%;border:7px solid #d9e2ee;box-shadow:0 0 0 2px #1d7cf2,0 14px 35px #000,inset 0 0 28px #000;position:relative;overflow:hidden;background:#07111f}
.wheelCanvas{position:absolute;inset:0;width:100%;height:100%;border-radius:50%;transition:transform 5.4s cubic-bezier(.08,.78,.16,1)}
.wheelHub{position:absolute;z-index:5;left:50%;top:50%;transform:translate(-50%,-50%);width:92px;height:92px;border-radius:50%;background:radial-gradient(circle,#17263a,#050a12);border:4px solid #1785ff;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:15px;line-height:1.05;box-shadow:0 0 20px #1785ff66,0 4px 14px #000}
.pointer{position:absolute;z-index:7;top:-7px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:20px solid transparent;border-right:20px solid transparent;border-top:46px solid #ef3d35;filter:drop-shadow(0 3px 3px #000)}
.spinRow{display:flex;gap:12px}.spinBtn{flex:1;background:linear-gradient(#1688ff,#0756c7);color:#fff;font-size:19px;border-radius:14px;box-shadow:0 5px 0 #06377f;font-weight:900}.spinBtn:active{transform:translateY(2px)}
.spin2.ready{background:linear-gradient(#1688ff,#0756c7);color:#fff}
.spinStatus{min-height:28px;margin-top:14px;font-weight:900;color:#6fb5ff;font-size:18px}
.selectedGame{margin-top:12px;background:#f7fbff;color:#111;border-radius:14px;padding:12px;text-align:left;border:2px solid #1785ff}.selectedGame strong{display:block;font-size:17px}.selectedGame small{color:#6b7280}
.wheelHint{font-size:13px;color:#b9c7d9;margin-top:12px;line-height:1.4}
.accessCard{background:#eef6ff;border:2px solid #1785ff}
.accessOk{background:#e9fff2!important;border-color:#18a957!important}
.unlockBtn{background:linear-gradient(#1688ff,#0756c7)}
@media(max-width:430px){
 .wrap{padding:8px}.brand h1{font-size:34px}.brand p{font-size:16px}
 .wheelCard{padding:14px 7px}.wheelTitle{font-size:23px}.wheelSub{font-size:13px}
 .wheelStage{width:94vw;height:94vw;max-width:430px;max-height:430px}
 .wheelHub{width:76px;height:76px;font-size:13px}.pointer{border-left-width:16px;border-right-width:16px;border-top-width:38px}
 .spinRow{gap:8px}.spinBtn{font-size:16px;padding:14px 7px}
}

.score input:disabled{background:#d1d5db!important;color:#374151!important;border:2px solid #9ca3af!important;opacity:1!important;font-weight:900!important}
.lockedNote{margin-top:8px;padding:10px;border-radius:10px;background:#e5e7eb;color:#374151;font-weight:800;text-align:center}
.newWeekLocked{opacity:.65!important;cursor:not-allowed!important}

/* SUPER 2s visual home upgrade — presentation only */
.appHero{margin:6px 0 14px;padding:22px 18px;border-radius:24px;background:linear-gradient(145deg,#081426,#12345a);color:#fff;text-align:center;border:1px solid #1b5d9d;box-shadow:0 12px 30px #0003;position:relative;overflow:hidden}
.appHero:before{content:"";position:absolute;width:180px;height:180px;border-radius:50%;right:-70px;top:-80px;background:#1785ff22}
.appHero .ball{font-size:48px;display:block;line-height:1;margin-bottom:6px}
.appHero h1{margin:0;font-size:38px;letter-spacing:2px;font-weight:900}
.appHero p{margin:6px 0 16px;color:#cbd8e8;font-size:15px;font-weight:700}
.appHero .tag{display:inline-block;padding:6px 12px;border-radius:999px;background:#1785ff;color:#fff;font-size:12px;font-weight:900;letter-spacing:.6px}
.quickNav{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.quickBtn{border:0;border-radius:14px;padding:15px 10px;background:#fff;color:#111827;font-size:15px;font-weight:900;box-shadow:0 3px 14px #00000010;border:1px solid #e5e7eb}
.quickBtn.primary{background:linear-gradient(#1688ff,#0756c7);color:#fff;border-color:#0756c7}
.quickBtn span{display:block;font-size:22px;margin-bottom:4px}
.rulesCard{display:none;background:#fff;border-radius:18px;padding:18px;margin:0 0 12px;box-shadow:0 3px 14px #00000010;border:1px solid #e5e7eb}
.rulesCard h2{margin-bottom:8px}
.rulesCard ol{margin:8px 0 0;padding-left:22px}
.rulesCard li{margin:8px 0;line-height:1.4;font-size:14px}
.sectionLabel{font-size:12px;font-weight:900;letter-spacing:1px;color:#6b7280;margin:14px 2px 6px;text-transform:uppercase}
@media(max-width:430px){.appHero{padding:18px 14px}.appHero h1{font-size:34px}.quickBtn{padding:13px 8px;font-size:14px}}

</style>
</head>
<body>
<div class="wrap">


<div class="appHero">
  <span class="ball">⚽</span>
  <h1>SUPER 2s</h1>
  <p>THE ULTIMATE 2-GAME SCORE PREDICTION</p>
  <span class="tag">PREMIER LEAGUE • EVERY WEEK</span>
</div>
<div class="quickNav">
  <button class="quickBtn primary" id="homePlayBtn" type="button"><span>🎡</span>PLAY SUPER 2s</button>
  <button class="quickBtn" id="homeRulesBtn" type="button"><span>📜</span>RULES</button>
  <button class="quickBtn" id="homeScoresBtn" type="button"><span>📊</span>MY / SCORES</button>
  <button class="quickBtn" id="homeWinnersBtn" type="button"><span>🏆</span>WINNERS</button>
</div>
<div class="rulesCard" id="homeRulesCard">
  <h2>📜 SUPER 2s RULES</h2>
  <ol>
    <li>The wheel selects the two games for the competition.</li>
    <li>Players enter a prediction for both selected games.</li>
    <li>Your prediction is locked once submitted and cannot be changed.</li>
    <li>You must get Game 1 exactly correct for your Game 2 prediction to count.</li>
    <li>Everyone who has entered their predictions can see the competition.</li>
    <li>The winner is any player who gets both exact scores correct. If more than one player does it, they are joint winners.</li>
  </ol>
</div>
<div class="sectionLabel">This week's competition</div>
<div class="brand"><h1>SUPER 2s</h1><p>Predict both exact scores</p></div>

<div class="card wheelCard" id="wheelCardScrollTarget">
  <div class="wheelTitle">🎡 SUPER 2s WHEEL</div>
  <div class="wheelSub">Friday–Monday Premier League fixtures · <span id="wheelCount">Loading fixtures…</span></div>
  <div class="wheelStage" id="wheelStage">
    <div class="pointer"></div>
    <div id="wheel" class="wheel"><canvas id="wheelCanvas" class="wheelCanvas"></canvas></div>
    <div class="wheelHub">SUPER<br>2s</div>
  </div>
  <div class="spinRow">
    <button class="btn spinBtn" id="spinBtn1" type="button" disabled>SPIN GAME 1</button>
    <button class="btn spinBtn spin2" id="spinBtn2" type="button" disabled>SPIN GAME 2</button>
  </div>
  <button class="btn" id="newWeekBtn" type="button" style="background:#17334f">NEW WEEK</button>
  <div id="spinStatus" class="spinStatus">Loading wheel…</div>
  <div id="selectedGame" class="selectedGame hidden"></div>
  <div class="wheelHint">The organiser's two games are selected centrally. Spin once for Game 1, then again for Game 2.</div>
</div>

<div class="card" id="possibleGamesCard" style="display:none">
  <h2>🎡 This week's games</h2>
  <div id="games"><div class="msg">Loading fixtures…</div></div>
  <div class="small">Games are selected centrally. Both kick-offs must be at least 2 hours apart and fixtures must be Friday–Monday.</div>
</div>

<div class="card accessCard" id="accessCard">
  <h2>🔐 Enter the SUPER 2s PIN</h2>
  <div class="small">Enter the PIN supplied by the organiser before you can spin the wheel or enter a prediction.</div>
  <label>Game PIN</label>
  <input id="gamePin" inputmode="numeric" maxlength="4" placeholder="4-digit Game PIN">
  <button class="btn unlockBtn" id="unlockBtn" type="button">UNLOCK GAME</button>
  <div id="accessMessage"></div>
</div>

<div class="card organiserLoginCard" id="organiserLoginCard">
  <h2>🔑 ORGANISER LOGIN</h2>
  <div class="small">Organiser only. Enter your private organiser PIN to access the weekly Game PIN controls.</div>
  <label>Organiser PIN</label>
  <input id="organiserPin" inputmode="numeric" maxlength="4" placeholder="4-digit organiser PIN">
  <button class="btn" id="organiserLoginBtn" type="button" style="background:#17334f">ORGANISER LOGIN</button>
  <div id="organiserLoginMessage"></div>
</div>

<div class="card organiserCard hidden" id="organiserCard">
  <h2>🔑 ORGANISER — CHANGE GAME PIN</h2>
  <div class="small">Use this section to change the PIN players use to unlock this week's game.</div>
  <label>New 4-digit Game PIN</label>
  <input id="newGamePin" inputmode="numeric" maxlength="4" placeholder="Enter new 4-digit PIN">
  <button class="btn changePinBtn" id="changePinBtn" type="button">CHANGE GAME PIN</button>
  <div id="changePinMessage"></div>
</div>

<div class="card hidden" id="loginCard">
  <h2>📝 Player</h2>
  <div id="playerChoice">
    <div class="small">Choose an option to continue:</div>
    <button class="btn" id="newPlayerBtn" type="button">NEW PLAYER</button>
    <button class="btn" id="existingPlayerBtn" type="button" style="background:#17334f">EXISTING PLAYER</button>
  </div>
  <div id="playerForm" class="hidden">
    <div id="playerModeMessage" class="small" style="margin-top:6px"></div>
    <label>Your unique name</label>
    <input id="name" autocomplete="name" placeholder="Enter your name">
    <label>Your 4-digit PIN</label>
    <input id="pin" inputmode="numeric" maxlength="4" placeholder="4 digits">
    <div class="small" style="margin-top:6px" id="playerHelp"></div>
  </div>
  <div id="predForm" class="hidden">
    <div id="predGames"></div>
    <button class="btn" id="submitBtn" type="button">🔒 SUBMIT &amp; LOCK PREDICTIONS</button>
  </div>
  <button class="btn" id="continueBtn" type="button">Continue</button>
  <div id="message"></div>
</div>

<div class="card hidden" id="submittedCard">
  <h2>✅ Your predictions are locked</h2>
  <div id="myPrediction"></div>
  <p class="small">Your predictions cannot be changed after submission.</p>
</div>

<div class="card hidden" id="othersCard">
  <h2>📋 Submitted predictions</h2>
  <div id="others"></div>
</div>

<div class="card winner" id="winnerCard">
  <div class="confetti" id="confetti"></div>
  <div class="trophy">🏆</div>
  <h2 class="gold">SUPER 2s WINNER!</h2>
  <div id="winnerText"></div>
</div>

</div>

<script>
const SUPABASE_URL="https://hwgxfgmmupnxhtviuqks.supabase.co";
const SUPABASE_KEY="sb_publishable_4MAxToZrtx1OUoLj5s6d1g_TC8rHqrM";
const sb=supabase.createClient(SUPABASE_URL,SUPABASE_KEY);

let GAME_ACCESS_PIN="2580";

let currentWeek=null,playerId=null,currentGames=[],wheelGames=[];
let spinCount=0,spinning=false,wheelRotation=0,selectedIndex1=-1,selectedIndex2=-1,gameUnlocked=false,playerMode=null,organiserPinVerified=false,organiserPinSession="";

const $=id=>document.getElementById(id);
function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]))}
function msg(t){$("message").innerHTML='<div class="msg">'+esc(t)+'</div>'}
function dateLabel(d){return new Intl.DateTimeFormat("en-GB",{weekday:"short",day:"numeric",month:"short",hour:"2-digit",minute:"2-digit"}).format(new Date(d))}

function drawWheel(){
  const list=wheelGames,canvas=$("wheelCanvas"),stage=$("wheelStage");
  if(!canvas||!stage||!list.length)return;
  const n=list.length,size=Math.max(320,Math.min(560,Math.floor(window.innerWidth*.94)));
  stage.style.width=size+"px";stage.style.height=size+"px";
  canvas.width=size*2;canvas.height=size*2;
  const ctx=canvas.getContext("2d"),r=size,cx=r,cy=r,seg=Math.PI*2/n;
  ctx.clearRect(0,0,size*2,size*2);
  const colours=["#0b1d35","#12345a","#0b2442","#173e67","#0a1a31","#16436f"];
  list.forEach((g,i)=>{
    const a0=-Math.PI/2+i*seg+.006,a1=-Math.PI/2+(i+1)*seg-.006,mid=(a0+a1)/2;
    const isGame1=i===selectedIndex1,isGame2=i===selectedIndex2;
    ctx.beginPath();ctx.moveTo(cx,cy);ctx.arc(cx,cy,r-5,a0,a1);ctx.closePath();
    ctx.fillStyle=isGame1?"#ffd400":isGame2?"#18c96b":colours[i%colours.length];ctx.fill();
    ctx.strokeStyle=(isGame1||isGame2)?"#fff":"#8ea4bd";ctx.lineWidth=(isGame1||isGame2)?4:2;ctx.stroke();
    const fs=Math.max(9,Math.min(16,215/n));
    ctx.save();ctx.translate(cx+Math.cos(mid)*r*.69,cy+Math.sin(mid)*r*.69);ctx.rotate(mid+Math.PI/2);
    ctx.textAlign="center";ctx.textBaseline="middle";
    ctx.fillStyle=(isGame1||isGame2)?"#07111f":"#fff";ctx.font=`900 ${fs}px Arial`;
    let label=(g.home||"")+" v "+(g.away||"");if(label.length>31)label=label.slice(0,30)+"…";
    ctx.fillText(label,0,-6);
    ctx.fillStyle=(isGame1||isGame2)?"#07111f":"#39a1ff";ctx.font=`900 ${Math.max(8,fs-1)}px Arial`;
    ctx.fillText(dateLabel(g.kick).replace(/^[A-Za-z]{3},?\s*/,""),0,fs+8);ctx.restore();
  });
  ctx.beginPath();ctx.arc(cx,cy,r-7,0,Math.PI*2);ctx.strokeStyle="#1785ff";ctx.lineWidth=3;ctx.stroke();
}

function setupWheel(){
  if(wheelGames.length<2)return;
  spinCount=0;spinning=false;wheelRotation=0;selectedIndex1=-1;selectedIndex2=-1;
  const w=$("wheel");w.style.transition="none";w.style.transform="rotate(0deg)";
  drawWheel();
  $("newWeekBtn").disabled=true;
  $("newWeekBtn").classList.add("newWeekLocked");
  $("newWeekBtn").textContent="🔒 NEW WEEK — SIGN IN OR JOIN FIRST";
  $("spinBtn1").disabled=!(gameUnlocked&&playerId);$("spinBtn2").disabled=true;
  $("spinBtn1").textContent="SPIN GAME 1";$("spinBtn2").textContent="SPIN GAME 2";
  $("spinBtn2").classList.remove("ready");
  $("spinStatus").textContent=!gameUnlocked?"Enter the Game PIN to unlock":(!playerId?"Sign in or join as a player to spin Game 1":"Ready — spin Game 1");
  $("selectedGame").classList.add("hidden");$("selectedGame").innerHTML="";
}

function spinWheel(which){
  if(!gameUnlocked||!playerId||spinning||spinCount>=2||wheelGames.length<2||currentGames.length<2)return;
  if(which===1&&spinCount!==0)return;if(which===2&&spinCount!==1)return;
  const targetGame=currentGames[which-1];if(!targetGame)return;
  spinning=true;$("spinBtn1").disabled=true;$("spinBtn2").disabled=true;
  $("spinStatus").textContent=which===1?"Spinning Game 1…":"Spinning Game 2…";
  let index=wheelGames.findIndex(g=>g.home===targetGame.home&&g.away===targetGame.away&&Math.abs(new Date(g.kick)-new Date(targetGame.kick))<120000);
  if(index<0)index=which===1?0:Math.min(1,wheelGames.length-1);
  if(which===2&&index===selectedIndex1)index=(index+1)%wheelGames.length;
  const segment=360/wheelGames.length,targetAngle=-(index*segment+segment/2);
  const currentMod=((wheelRotation%360)+360)%360,turns=6+Math.floor(Math.random()*3);
  const finalRotation=wheelRotation+turns*360+targetAngle-currentMod;
  const w=$("wheel");w.style.transition="transform 5.4s cubic-bezier(.08,.78,.16,1)";w.style.transform=`rotate(${finalRotation}deg)`;wheelRotation=finalRotation;
  setTimeout(()=>{
    if(which===1)selectedIndex1=index;else selectedIndex2=index;spinCount++;spinning=false;
    const picked=wheelGames[index];
    $("selectedGame").innerHTML+=`<div style="margin:8px 0"><strong>Game ${which}: ${esc(picked.home)} v ${esc(picked.away)}</strong><small>${dateLabel(picked.kick)}</small></div>`;
    $("selectedGame").classList.remove("hidden");
    if(playerId){
      if($("predForm").classList.contains("hidden")){
        renderPredictionForm();
        $("predForm").classList.remove("hidden");
      }
      revealPredictionGame(which);
    }
    drawWheel();
    if(spinCount===1){$("spinBtn2").disabled=false;$("spinBtn2").classList.add("ready");$("spinStatus").textContent="Game 1 selected — now spin Game 2";}
    else{$("spinBtn1").disabled=true;$("spinBtn2").disabled=true;$("spinBtn2").classList.remove("ready");$("spinBtn2").textContent="BOTH GAMES SELECTED ✓";$("spinStatus").textContent="Both SUPER 2s games revealed";}
  },5500);
}

async function loadAllWeekendGames(weekStart){
  /*
    FIX: The old version depended on the ESPN scoreboard API.
    On some phones/networks that request can hang indefinitely, leaving
    the whole page stuck on "Loading fixtures…".

    The current Premier League weekend is kept locally here, so the wheel
    loads immediately and does not depend on an external football API.
  */
  const fixtures = [
    {id:"ips-liv",home:"Ipswich Town",away:"Liverpool",kick:"2026-09-04T20:00:00+01:00"},
    {id:"new-bou",home:"Newcastle United",away:"AFC Bournemouth",kick:"2026-09-05T12:30:00+01:00"},
    {id:"bre-sun",home:"Brentford",away:"Sunderland",kick:"2026-09-05T15:00:00+01:00"},
    {id:"bha-lee",home:"Brighton & Hove Albion",away:"Leeds United",kick:"2026-09-05T15:00:00+01:00"},
    {id:"ful-cry",home:"Fulham",away:"Crystal Palace",kick:"2026-09-05T15:00:00+01:00"},
    {id:"mci-cov",home:"Manchester City",away:"Coventry City",kick:"2026-09-05T15:00:00+01:00"},
    {id:"nfo-tot",home:"Nottingham Forest",away:"Tottenham Hotspur",kick:"2026-09-05T15:00:00+01:00"},
    {id:"hul-avl",home:"Hull City",away:"Aston Villa",kick:"2026-09-05T17:30:00+01:00"},
    {id:"eve-mun",home:"Everton",away:"Manchester United",kick:"2026-09-06T14:00:00+01:00"},
    {id:"ars-che",home:"Arsenal",away:"Chelsea",kick:"2026-09-06T16:30:00+01:00"}
  ];

  return fixtures;
}

async function loadWeek(){
  $("spinStatus").textContent="Loading wheel…";
  const queryPromise=sb.from("weeks").select("*").order("week_start",{ascending:false}).limit(1).maybeSingle();
  const timeoutPromise=new Promise(resolve=>setTimeout(()=>resolve({data:null,error:{message:"The game database took too long to respond. Please refresh the page."}}),10000));
  const {data,error}=await Promise.race([queryPromise,timeoutPromise]);
  if(error){$("games").innerHTML='<div class="msg">Database connection error: '+esc(error.message)+'</div>';$("spinStatus").textContent="Database connection error";return}
  currentWeek=data;
  if(!data){$("games").innerHTML='<div class="msg">No games have been selected yet.</div>';$("spinStatus").textContent="No games selected";return}
  // Each week has its own Game PIN; older weeks default to 2580.
  GAME_ACCESS_PIN=String(data.game_pin||"2580");
  currentGames=[
    {home:data.game1_home,away:data.game1_away,kick:data.game1_kickoff,n:1},
    {home:data.game2_home,away:data.game2_away,kick:data.game2_kickoff,n:2}
  ];
  const all=await loadAllWeekendGames(data.week_start);
  const selectedKeys=new Set(currentGames.map(g=>g.home+"|"+g.away));
  const selected=all.filter(g=>selectedKeys.has(g.home+"|"+g.away)),others=all.filter(g=>!selectedKeys.has(g.home+"|"+g.away));
  wheelGames=[...selected,...others].slice(0,10);
  if(wheelGames.length<2||!currentGames.every(g=>wheelGames.some(x=>x.home===g.home&&x.away===g.away)))wheelGames=[...currentGames.map(g=>({...g})),...others].slice(0,10);

  // Randomise the wheel positions so the two centrally selected games are
  // not always next to each other. The selected games stay the same for
  // every player; only their positions on the wheel are randomised.
  if(wheelGames.length>2){
    let attempts=0;
    do{
      for(let i=wheelGames.length-1;i>0;i--){
        const j=Math.floor(Math.random()*(i+1));
        [wheelGames[i],wheelGames[j]]=[wheelGames[j],wheelGames[i]];
      }
      attempts++;
    }while(attempts<50&&(()=>{
      const a=wheelGames.findIndex(g=>g.home===currentGames[0].home&&g.away===currentGames[0].away);
      const b=wheelGames.findIndex(g=>g.home===currentGames[1].home&&g.away===currentGames[1].away);
      return Math.abs(a-b)===1||Math.abs(a-b)===wheelGames.length-1;
    })());
  }
  $("wheelCount").textContent=wheelGames.length+" eligible fixtures";renderGames();setupWheel();await loadWinner();
}

function renderGames(){
  $("games").innerHTML=currentGames.map(g=>`<div class="game"><b>${esc(g.home)} v ${esc(g.away)}</b><div class="kick">${dateLabel(g.kick)}</div></div>`).join("");
}
function renderPredictionForm(){
  $("predGames").innerHTML=currentGames.map(g=>`<div class="game predGame hidden" id="predGame${g.n}"><b>${esc(g.home)} v ${esc(g.away)}</b><div class="kick">${dateLabel(g.kick)}</div><label>Score</label><div class="score"><input id="g${g.n}h" inputmode="numeric" type="number" min="0" max="99" placeholder="Home"><input id="g${g.n}a" inputmode="numeric" type="number" min="0" max="99" placeholder="Away"></div></div>`).join("");
  $("submitBtn").classList.add("hidden");
}

/*
  IMPORTANT FIX:
  Existing players are checked by name BEFORE calling create_player.
  This prevents an existing player such as Nic from being sent to
  create_player and producing "That player name is already in use".
*/
function revealPredictionGame(which){
  const card=$("predGame"+which);
  if(!card)return;
  card.classList.remove("hidden");

  if(existingPrediction){
    const prefix=which===1?"g1":"g2";
    const values=which===1
      ? [[prefix+"h",existingPrediction.game1_home_score],[prefix+"a",existingPrediction.game1_away_score]]
      : [[prefix+"h",existingPrediction.game2_home_score],[prefix+"a",existingPrediction.game2_away_score]];
    values.forEach(([id,value])=>{
      const el=$(id);
      if(!el)return;
      el.value=value;
      el.disabled=true;
      el.readOnly=true;
    });
  }

  if(spinCount===2 && !existingPrediction){
    $("submitBtn").classList.remove("hidden");
  }
}

async function continuePlayer(){
  if(!gameUnlocked)return msg("Please enter the Game PIN first.");
  if(!playerMode)return msg("Please choose NEW PLAYER or EXISTING PLAYER first.");

  const name=$("name").value.trim();
  const pin=$("pin").value.trim();

  if(name.length<2)return msg("Please enter your name.");
  if(!/^\d{4}$/.test(pin))return msg("PIN must be exactly 4 digits.");
  if(!currentWeek)return msg("This week's games are not available yet.");

  $("continueBtn").disabled=true;
  $("message").innerHTML="";

  let r;

  if(playerMode==="existing"){
    // Existing player: verify the name + PIN. Never create an account here.
    r=await sb.rpc("check_player",{p_name:name,p_pin:pin});
    if(r.error){
      $("continueBtn").disabled=false;
      return msg("Existing player not found, or the PIN is incorrect.");
    }
  }else{
    // New player: create a brand-new account. Never log in an existing one here.
    r=await sb.rpc("create_player",{p_name:name,p_pin:pin});
    if(r.error){
      $("continueBtn").disabled=false;
      return msg(r.error.message);
    }
    $("message").innerHTML='<div class="msg">✅ New player account created for <b>'+esc(name)+'</b>. Now enter your two predictions.</div>';
  }

  playerId=r.data;

  // Check the database BEFORE enabling either spin button.
  // Existing players who have already submitted this week must not be able to spin again.

  // Use the secure RPC to check for an existing locked prediction.
  const {data:existingRows,error:predictionError}=await sb.rpc("get_my_prediction",{
    p_week_id:currentWeek.id,
    p_player_id:playerId
  });

  if(predictionError){
    $("continueBtn").disabled=false;
    return msg("Could not check your prediction: "+predictionError.message);
  }

  const existing=existingRows&&existingRows.length?existingRows[0]:null;

  if(existing){
    existingPrediction=existing;
    renderPredictionForm();
    $("predForm").classList.remove("hidden");
    $("continueBtn").classList.add("hidden");
    $("submitBtn").classList.add("hidden");

    // Existing players see their already-submitted scores immediately.
    [
      ["g1h",existing.game1_home_score],["g1a",existing.game1_away_score],
      ["g2h",existing.game2_home_score],["g2a",existing.game2_away_score]
    ].forEach(([id,value])=>{
      const el=$(id);
      if(!el)return;
      el.value=value;
      el.disabled=true;
      el.readOnly=true;
    });

    $("predGames").querySelectorAll(".predGame").forEach(card=>card.classList.remove("hidden"));
    $("predGames").insertAdjacentHTML("afterbegin",'<div class="lockedNote">🔒 YOUR PREDICTIONS ARE ALREADY LOCKED — THEY CANNOT BE CHANGED</div>');
    showSubmitted(existing);
    lockNewWeekButton();
    lockSpinButtons("🔒 Your predictions are already submitted — the wheel is locked for this week");
    await showOthers();
    return;
  }

  existingPrediction=null;
  $("newWeekBtn").disabled=false;
  $("newWeekBtn").classList.remove("newWeekLocked");
  $("newWeekBtn").textContent="NEW WEEK";
  $("predForm").classList.add("hidden");
  $("continueBtn").classList.add("hidden");
  if(wheelGames.length>=2 && gameUnlocked && spinCount===0){
    $("spinBtn1").disabled=false;
    $("spinBtn2").disabled=true;
    $("spinStatus").textContent="Ready — spin Game 1";
  }
  $("message").innerHTML='<div class="msg">✅ Player ready. Spin Game 1, then Game 2 to reveal your games.</div>';
}

async function submit(){
  if(!gameUnlocked)return msg("Please enter the Game PIN first.");
  const vals=["g1h","g1a","g2h","g2a"].map(id=>$(id).value);
  if(vals.some(v=>v===""||Number(v)<0))return msg("Please enter all four scores.");

  const scores={
    game1_home_score:Number(vals[0]),
    game1_away_score:Number(vals[1]),
    game2_home_score:Number(vals[2]),
    game2_away_score:Number(vals[3])
  };

  const r=await sb.rpc("submit_prediction",{
    p_week_id:currentWeek.id,
    p_player_id:playerId,
    p_game1_home:scores.game1_home_score,
    p_game1_away:scores.game1_away_score,
    p_game2_home:scores.game2_home_score,
    p_game2_away:scores.game2_away_score
  });
  if(r.error){msg(r.error.message);return}

  // Lock the four boxes immediately after a successful submission.
  [["g1h",scores.game1_home_score],["g1a",scores.game1_away_score],["g2h",scores.game2_home_score],["g2a",scores.game2_away_score]]
    .forEach(([id,value])=>{const el=$(id);el.value=value;el.disabled=true;el.readOnly=true;});

  $("submitBtn").classList.add("hidden");
  $("predGames").insertAdjacentHTML("afterbegin",'<div class="lockedNote">🔒 YOUR PREDICTIONS ARE NOW LOCKED — THEY CANNOT BE CHANGED</div>');

  const p={...scores};
  showSubmitted(p);
  lockNewWeekButton();
  lockSpinButtons("🔒 Your predictions are submitted — the wheel is now locked for this week");
  await showOthers();
}
function lockSpinButtons(statusText){
  $("spinBtn1").disabled=true;
  $("spinBtn2").disabled=true;
  $("spinBtn2").classList.remove("ready");
  $("spinStatus").textContent=statusText;
}
function lockNewWeekButton(){
  const b=$("newWeekBtn");
  b.disabled=true;
  b.classList.add("newWeekLocked");
  b.textContent="🔒 NEW WEEK — PREDICTION SUBMITTED";
}
function showSubmitted(p){
  $("submittedCard").classList.remove("hidden");
  $("myPrediction").innerHTML=`<div class="game"><b>${esc(currentGames[0].home)} ${p.game1_home_score}–${p.game1_away_score} ${esc(currentGames[0].away)}</b></div><div class="game"><b>${esc(currentGames[1].home)} ${p.game2_home_score}–${p.game2_away_score} ${esc(currentGames[1].away)}</b></div>`;
}
async function showOthers(){
  // Supabase only releases the submitted list after THIS player has submitted.
  // Once Game 1 has a final result, remove every player who predicted Game 1 incorrectly.
  const r=await sb.rpc("get_submitted_predictions",{
    p_week_id:currentWeek.id,
    p_player_id:playerId
  });
  if(r.error){
    msg(r.error.message);
    return;
  }

  let rows=r.data||[];

  // Include the current player's own prediction in the full reveal table.
  const ownResult=await sb.rpc("get_my_prediction",{
    p_week_id:currentWeek.id,
    p_player_id:playerId
  });
  if(!ownResult.error && ownResult.data && ownResult.data.length){
    const own=ownResult.data[0];
    rows.unshift({
      player_name:$('name').value.trim() || 'YOU',
      game1_home_score:own.game1_home_score,
      game1_away_score:own.game1_away_score,
      game2_home_score:own.game2_home_score,
      game2_away_score:own.game2_away_score
    });
  }

  // Refresh the week scores so the reveal changes automatically after Game 1 is played.
  const weekResult=await sb.from("weeks")
    .select("game1_score_home,game1_score_away,game2_score_home,game2_score_away")
    .eq("id",currentWeek.id)
    .maybeSingle();

  const weekScores=weekResult.data||{};
  const game1Finished=weekScores.game1_score_home!==null && weekScores.game1_score_home!==undefined
    && weekScores.game1_score_away!==null && weekScores.game1_score_away!==undefined;

  if(game1Finished){
    rows=rows.filter(x=>
      Number(x.game1_home_score)===Number(weekScores.game1_score_home) &&
      Number(x.game1_away_score)===Number(weekScores.game1_score_away)
    );
  }

  const game2Finished=weekScores.game2_score_home!==null && weekScores.game2_score_home!==undefined
    && weekScores.game2_score_away!==null && weekScores.game2_score_away!==undefined;

  if(game2Finished){
    rows=rows.filter(x=>
      Number(x.game2_home_score)===Number(weekScores.game2_score_home) &&
      Number(x.game2_away_score)===Number(weekScores.game2_score_away)
    );
  }

  $("othersCard").classList.remove("hidden");
  $("others").innerHTML=`
    <div class="msg" style="background:#e9fff2;border:1px solid #18a957;color:#116b39;font-weight:800;margin-bottom:10px">
      ${game2Finished
        ? `🏆 BOTH GAMES FINISHED: GAME 1 ${weekScores.game1_score_home}–${weekScores.game1_score_away}, GAME 2 ${weekScores.game2_score_home}–${weekScores.game2_score_away} — ONLY PLAYERS WHO GOT BOTH GAMES CORRECT REMAIN`
        : game1Finished
          ? `⚽ GAME 1 FINISHED: ${weekScores.game1_score_home}–${weekScores.game1_score_away} — ONLY PLAYERS WHO GOT GAME 1 CORRECT REMAIN`
          : `🔓 ALL SUBMITTED PREDICTIONS ARE NOW REVEALED`}
    </div>
    ${rows.length ? `
      <div class="predTableWrap">
        <table class="predTable">
          <thead><tr><th>PLAYER</th><th>GAME 1</th><th>GAME 2</th></tr></thead>
          <tbody>${rows.map((x,i)=>`
            <tr>
              <td class="p${i%6}">${esc(x.player_name)}</td>
              <td class="p${i%6}"><span class="predScore">${x.game1_home_score}–${x.game1_away_score}</span></td>
              <td class="p${i%6}"><span class="predScore">${x.game2_home_score}–${x.game2_away_score}</span></td>
            </tr>`).join("")}</tbody>
        </table>
      </div>` : game1Finished
        ? '<div class="small">No players remain — nobody predicted Game 1 exactly.</div>'
        : '<div class="small">No other players have submitted yet.</div>'}`;

  // Make the reveal immediately visible on a phone after submission.
  setTimeout(()=>$('othersCard').scrollIntoView({behavior:'smooth',block:'start'}),100);
}

async function loadWinner(){
  if(!currentWeek)return;
  const r=await sb.rpc("get_winners",{p_week_id:currentWeek.id});
  if(r.error||!r.data||!r.data.length)return;
  $("winnerCard").style.display="block";
  $("winnerText").innerHTML=r.data.map(w=>`<div class="pred">${esc(w.player_name)}</div><div>${esc(currentGames[0].home)} ${esc(w.game1_prediction)} ${esc(currentGames[0].away)}</div><div>${esc(currentGames[1].home)} ${esc(w.game2_prediction)} ${esc(currentGames[1].away)}</div>`).join("<hr>");
  for(let i=0;i<28;i++){const e=document.createElement("i");e.style.left=(i*3.7)+"%";e.style.animationDelay=((i%7)*.18)+"s";$("confetti").appendChild(e)}
}


$("homePlayBtn").addEventListener("click",()=>{$("wheelCardScrollTarget").scrollIntoView({behavior:"smooth",block:"start"})});
$("homeRulesBtn").addEventListener("click",()=>{const c=$("homeRulesCard");c.style.display=c.style.display==="block"?"none":"block";if(c.style.display==="block")c.scrollIntoView({behavior:"smooth",block:"center"})});
$("homeScoresBtn").addEventListener("click",()=>{$("submittedCard").scrollIntoView({behavior:"smooth",block:"start"})});
$("homeWinnersBtn").addEventListener("click",()=>{const c=$("winnerCard");c.style.display==="none"?$("othersCard").scrollIntoView({behavior:"smooth",block:"start"}):c.scrollIntoView({behavior:"smooth",block:"start"})});

$("newPlayerBtn").addEventListener("click",()=>{
  playerMode="new";
  $("playerChoice").classList.add("hidden");
  $("playerForm").classList.remove("hidden");
  $("playerModeMessage").textContent="NEW PLAYER — create your player account";
  $("playerHelp").textContent="Choose a name and 4-digit PIN. Your account will be created when you continue.";
  $("continueBtn").classList.remove("hidden");
  $("continueBtn").textContent="CREATE NEW PLAYER & CONTINUE";
});

$("existingPlayerBtn").addEventListener("click",()=>{
  playerMode="existing";
  $("playerChoice").classList.add("hidden");
  $("playerForm").classList.remove("hidden");
  $("playerModeMessage").textContent="EXISTING PLAYER — sign in to your account";
  $("playerHelp").textContent="Enter the name and 4-digit PIN you used previously.";
  $("continueBtn").classList.remove("hidden");
  $("continueBtn").textContent="EXISTING PLAYER — CONTINUE";
});

$("unlockBtn").addEventListener("click",()=>{
  const pin=$("gamePin").value.trim();
  if(pin!==GAME_ACCESS_PIN){
    gameUnlocked=false;$("accessCard").classList.remove("accessOk");
    $("accessMessage").innerHTML='<div class="msg">❌ Incorrect PIN. Please enter the PIN supplied by the organiser.</div>';
    $("spinBtn1").disabled=true;$("spinBtn2").disabled=true;$("loginCard").classList.add("hidden");return;
  }
  gameUnlocked=true;$("accessCard").classList.add("accessOk");
  $("accessMessage").innerHTML='<div class="msg">✅ Game unlocked. You can now spin the wheel and enter your prediction.</div>';
  $("gamePin").disabled=true;$("unlockBtn").disabled=true;$("loginCard").classList.remove("hidden");
  $("spinBtn1").disabled=!(gameUnlocked&&playerId&&spinCount===0);
  $("newWeekBtn").disabled=!playerId;
  $("spinStatus").textContent=!playerId?"Sign in or join as a player to spin Game 1":(spinCount===0?"Ready — spin Game 1":"Game already started");
});
$("organiserLoginBtn").addEventListener("click",async()=>{
  const pin=$("organiserPin").value.trim();
  if(!/^\d{4}$/.test(pin)){
    $("organiserLoginMessage").innerHTML='<div class="msg">❌ Please enter exactly 4 digits.</div>';
    return;
  }
  $("organiserLoginBtn").disabled=true;
  $("organiserLoginMessage").innerHTML='<div class="msg">Checking organiser PIN…</div>';
  const r=await sb.rpc("check_organiser_pin",{p_pin:pin});
  if(r.error||!r.data){
    organiserPinVerified=false;organiserPinSession="";
    $("organiserLoginMessage").innerHTML='<div class="msg">❌ Incorrect organiser PIN.</div>';
    $("organiserLoginBtn").disabled=false;
    return;
  }
  organiserPinVerified=true;organiserPinSession=pin;
  $("organiserPin").disabled=true;
  $("organiserLoginBtn").disabled=true;
  $("organiserLoginMessage").innerHTML='<div class="msg">✅ Organiser access granted.</div>';
  $("organiserCard").classList.remove("hidden");
});

$("changePinBtn").addEventListener("click",async()=>{
  if(!organiserPinVerified||!organiserPinSession){
    $("changePinMessage").innerHTML='<div class="msg">❌ Organiser access required.</div>';
    return;
  }
  const newPin=$("newGamePin").value.trim();
  if(!/^\d{4}$/.test(newPin)){
    $("changePinMessage").innerHTML='<div class="msg">❌ Please enter exactly 4 digits.</div>';
    return;
  }
  if(!currentWeek){
    $("changePinMessage").innerHTML='<div class="msg">❌ This week is not loaded yet.</div>';
    return;
  }
  $("changePinBtn").disabled=true;
  $("changePinMessage").innerHTML='<div class="msg">Changing Game PIN…</div>';
  const r=await sb.rpc("change_game_pin",{p_week_id:currentWeek.id,p_organiser_pin:organiserPinSession,p_new_pin:newPin});
  if(r.error){
    $("changePinMessage").innerHTML='<div class="msg">❌ '+esc(r.error.message)+'</div>';
    $("changePinBtn").disabled=false;
    return;
  }
  GAME_ACCESS_PIN=newPin;
  currentWeek.game_pin=newPin;
  $("newGamePin").value="";
  $("changePinMessage").innerHTML='<div class="msg">✅ Game PIN changed successfully. The new PIN is <b>'+esc(newPin)+'</b>.</div>';
  $("changePinBtn").disabled=false;
});
$("gamePin").addEventListener("input",e=>{e.target.value=e.target.value.replace(/\D/g,"").slice(0,4)});
$("pin").addEventListener("input",e=>{e.target.value=e.target.value.replace(/\D/g,"").slice(0,4)});
$("newGamePin").addEventListener("input",e=>{e.target.value=e.target.value.replace(/\D/g,"").slice(0,4)});
$("organiserPin").addEventListener("input",e=>{e.target.value=e.target.value.replace(/\D/g,"").slice(0,4)});
$("spinBtn1").addEventListener("click",()=>spinWheel(1));
$("spinBtn2").addEventListener("click",()=>spinWheel(2));
$("continueBtn").addEventListener("click",continuePlayer);
$("submitBtn").addEventListener("click",submit);
$("newWeekBtn").addEventListener("click",()=>location.reload());
window.addEventListener("resize",()=>{if(wheelGames.length)drawWheel()});
loadWeek();
if("serviceWorker" in navigator){window.addEventListener("load",()=>navigator.serviceWorker.register("./sw.js").catch(()=>{}));}
</script>
</body>
</html>
