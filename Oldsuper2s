<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1">
<meta name="theme-color" content="#07152d">
<title>SUPER 2s | Football Wheel</title>
<style>
:root{
  --navy:#06152f;--navy2:#0b2347;--gold:#f6c945;--white:#fff;
  --muted:#aebbd0;--line:#ffffff20;--green:#39d98a;
}
*{box-sizing:border-box}
body{
  margin:0;min-height:100vh;font-family:Arial,Helvetica,sans-serif;color:var(--white);
  background:
    radial-gradient(circle at 50% -10%,#194b86 0,#0b2347 35%,#06152f 75%);
}
.wrap{max-width:560px;margin:auto;padding:14px 12px 30px}
.header{text-align:center;padding:8px 0 12px}
.brand{font-size:13px;letter-spacing:3px;font-weight:900;color:var(--gold)}
h1{margin:4px 0 0;font-size:38px;line-height:1;font-weight:1000;letter-spacing:1px}
.sub{margin-top:8px;color:var(--muted);font-size:14px}
.card{
  background:linear-gradient(180deg,#ffffff12,#ffffff08);
  border:1px solid var(--line);border-radius:24px;padding:14px;
  box-shadow:0 20px 60px #0008;backdrop-filter:blur(10px)
}
.weekbar{
  display:flex;justify-content:space-between;align-items:center;
  padding:10px 12px;border-radius:14px;background:#00000025;border:1px solid var(--line);
  font-weight:800;font-size:13px
}
.live{display:flex;align-items:center;gap:6px;color:#dfffea}
.dot{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 10px var(--green)}
.wheelbox{position:relative;width:min(91vw,420px);height:min(91vw,420px);margin:14px auto 12px}
canvas{width:100%;height:100%;border-radius:50%;display:block;box-shadow:0 15px 45px #000b}
.pointer{
  position:absolute;top:-5px;left:50%;transform:translateX(-50%);
  width:0;height:0;border-left:16px solid transparent;border-right:16px solid transparent;
  border-top:34px solid var(--gold);filter:drop-shadow(0 3px 3px #0008);z-index:3
}
.controls{display:grid;grid-template-columns:1fr 1fr;gap:9px}
button{
  border:0;border-radius:14px;padding:15px 10px;font-size:16px;font-weight:900;
  cursor:pointer;touch-action:manipulation
}
#spin{grid-column:1/-1;background:linear-gradient(180deg,#ffe06a,#eeb72b);color:#06152f;box-shadow:0 8px 20px #0005}
#newweek{background:#ffffff10;color:#fff;border:1px solid var(--line)}
#spin:disabled{opacity:.45;cursor:default}
.status{
  margin:12px 0 0;text-align:center;min-height:64px;padding:10px;
  border-radius:14px;background:#00000025;border:1px solid var(--line)
}
.status .label{font-size:11px;letter-spacing:2px;color:var(--muted);font-weight:900}
.status .game{font-size:21px;font-weight:1000;margin-top:4px}
.status .time{font-size:13px;color:var(--gold);font-weight:800;margin-top:3px}
.selection{
  margin-top:12px;display:grid;grid-template-columns:1fr 1fr;gap:9px
}
.pick{
  border:1px solid var(--line);background:#ffffff0b;border-radius:15px;padding:11px;text-align:center;
  min-height:76px
}
.pick .num{font-size:11px;color:var(--muted);font-weight:900;letter-spacing:1px}
.pick .teams{font-size:14px;font-weight:900;margin-top:6px;line-height:1.25}
.pick .kick{font-size:12px;color:var(--gold);font-weight:800;margin-top:5px}
.fixtures{margin-top:14px;border-top:1px solid var(--line);padding-top:12px}
.fixtures summary{cursor:pointer;font-weight:900;color:#fff;padding:5px 0}
.fixture{display:flex;justify-content:space-between;gap:8px;padding:9px 0;border-bottom:1px solid #ffffff12;font-size:13px}
.fixture:last-child{border-bottom:0}
.teams{font-weight:800}
.kickoff{color:var(--gold);font-weight:900;white-space:nowrap}
.note{text-align:center;color:var(--muted);font-size:11px;line-height:1.5;margin-top:12px}
.lock{color:var(--green);font-weight:900}
</style>
</head>
<body>
<div class="wrap">
  <div class="header">
    <div class="brand">FOOTBALL • SHARED WHEEL</div>
    <h1>SUPER 2s</h1>
    <div class="sub">Two games. One shared result.</div>
  </div>

  <div class="card">
    <div class="weekbar">
      <span>PREMIER LEAGUE • MATCHWEEK 2</span>
      <span class="live"><span class="dot"></span>LIVE</span>
    </div>

    <div class="wheelbox">
      <div class="pointer"></div>
      <canvas id="wheel" width="760" height="760"></canvas>
    </div>

    <div class="controls">
      <button id="spin">SPIN GAME 1</button>
      <button id="newweek">NEW WEEK</button>
    </div>

    <div id="status" class="status">
      <div class="label">READY TO PLAY</div>
      <div class="game">Spin to reveal Game 1</div>
      <div class="time">Everyone gets the same selections</div>
    </div>

    <div class="selection">
      <div class="pick"><div class="num">GAME 1</div><div id="pick1" class="teams">—</div><div id="time1" class="kick">—</div></div>
      <div class="pick"><div class="num">GAME 2</div><div id="pick2" class="teams">—</div><div id="time2" class="kick">—</div></div>
    </div>

    <details class="fixtures">
      <summary>Show this week's fixtures & kick-off times</summary>
      <div id="fixtureList"></div>
    </details>

    <div class="note">
      <span class="lock">🔒 SAME FOR EVERYONE</span><br>
      The two selected games are fixed for this week. Game 2 can only be a fixture with a different kick-off time from Game 1.
    </div>
  </div>
</div>

<script>
const fixtures = [
  ["Crystal Palace","Man City","Fri 28 Aug","20:00"],
  ["Liverpool","Nottingham Forest","Sat 29 Aug","12:30"],
  ["Bournemouth","Everton","Sat 29 Aug","14:00"],
  ["Coventry City","Hull City","Sat 29 Aug","14:00"],
  ["Tottenham","Newcastle","Sat 29 Aug","17:30"],
  ["Chelsea","Brighton","Sun 30 Aug","14:00"],
  ["Leeds","Brentford","Sun 30 Aug","14:00"],
  ["Sunderland","Fulham","Sun 30 Aug","14:00"],
  ["Man Utd","Ipswich Town","Sun 30 Aug","16:30"],
  ["Aston Villa","Arsenal","Mon 31 Aug","20:00"]
];

/* Fixed weekly seed = everyone gets the same two games.
   The second game is deliberately required to have a different kick-off time. */
const WEEK_SEED = "SUPER2S-MW2-2026";
function hash(str){
  let h=2166136261;
  for(let i=0;i<str.length;i++){h^=str.charCodeAt(i);h=Math.imul(h,16777619);}
  return h>>>0;
}
function pickSharedPair(){
  const first = hash(WEEK_SEED+"-1") % fixtures.length;
  const candidates = fixtures.map((f,i)=>i).filter(i=>fixtures[i][3]!==fixtures[first][3]);
  const second = candidates[hash(WEEK_SEED+"-2") % candidates.length];
  return [first,second];
}
const chosen = pickSharedPair();

const canvas=document.getElementById("wheel"),ctx=canvas.getContext("2d");
const n=fixtures.length,slice=2*Math.PI/n;
let rotation=0,spinning=false,spinNo=0;
const colors=["#0b3d91","#145da0","#176b87","#0b6e4f","#4c2a85","#7026a8","#8f174f","#a64b0b","#176b3b","#26364f"];

function draw(){
  ctx.clearRect(0,0,760,760);
  ctx.save();ctx.translate(380,380);ctx.rotate(rotation);
  for(let i=0;i<n;i++){
    const a=i*slice;
    ctx.beginPath();ctx.moveTo(0,0);ctx.arc(0,0,350,a,a+slice);ctx.closePath();
    ctx.fillStyle=colors[i%colors.length];ctx.fill();
    ctx.strokeStyle="#ffffff55";ctx.lineWidth=3;ctx.stroke();

    ctx.save();ctx.rotate(a+slice/2);ctx.translate(250,0);ctx.rotate(Math.PI/2);
    ctx.fillStyle="#fff";ctx.textAlign="center";ctx.textBaseline="middle";
    ctx.font="900 20px Arial";
    ctx.fillText(fixtures[i][0],0,-13);
    ctx.fillText("v "+fixtures[i][1],0,13);
    ctx.font="800 14px Arial";ctx.fillStyle="#f6c945";
    ctx.fillText(fixtures[i][3],0,38);
    ctx.restore();
  }
  ctx.beginPath();ctx.arc(0,0,68,0,Math.PI*2);ctx.fillStyle="#06152f";ctx.fill();
  ctx.strokeStyle="#f6c945";ctx.lineWidth=5;ctx.stroke();
  ctx.fillStyle="#f6c945";ctx.font="1000 30px Arial";ctx.textAlign="center";ctx.textBaseline="middle";
  ctx.fillText("2s",0,0);
  ctx.restore();
}
draw();

function targetRotation(index,turns){
  const center=index*slice+slice/2;
  return rotation+turns*2*Math.PI+(Math.PI*1.5-center-(rotation%(2*Math.PI)));
}
function showPick(slot,index){
  const f=fixtures[index];
  document.getElementById("pick"+slot).textContent=f[0]+" v "+f[1];
  document.getElementById("time"+slot).textContent=f[2]+" • "+f[3];
}
function spin(){
  if(spinning||spinNo>=2)return;
  spinning=true;
  const idx=chosen[spinNo],start=rotation,end=targetRotation(idx,6);
  const duration=3500,t0=performance.now();
  function anim(t){
    const p=Math.min(1,(t-t0)/duration),e=1-Math.pow(1-p,4);
    rotation=start+(end-start)*e;draw();
    if(p<1)requestAnimationFrame(anim);
    else{
      spinning=false;rotation=end;draw();
      const f=fixtures[idx];spinNo++;showPick(spinNo,idx);
      document.getElementById("status").innerHTML=
        '<div class="label">GAME '+spinNo+' SELECTED</div>'+
        '<div class="game">'+f[0]+' v '+f[1]+'</div>'+
        '<div class="time">'+f[2]+' • '+f[3]+'</div>';
      const b=document.getElementById("spin");
      b.textContent=spinNo===1?"SPIN GAME 2":"BOTH GAMES SELECTED";
      if(spinNo===2)b.disabled=true;
    }
  }
  requestAnimationFrame(anim);
}
document.getElementById("spin").onclick=spin;
document.getElementById("newweek").onclick=()=>{
  alert("This version is locked to Matchweek 2. To start a new week, update the weekly fixture list and WEEK_SEED in the shared file. Everyone will then receive the same two games, with different kick-off times.");
};

document.getElementById("fixtureList").innerHTML=fixtures.map((f,i)=>
  '<div class="fixture"><span class="teams">'+f[0]+' v '+f[1]+'<br><small>'+f[2]+'</small></span><span class="kickoff">'+f[3]+'</span></div>'
).join("");
</script>
</body>
</html>
